<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Video Player</title>
        <style>
            body {
                margin: 0;
                display: flex;
                place-items: center;
                min-width: 320px;
                min-height: 100vh;
                background: black;
            }
            video,
            img {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                object-fit: cover;
            }
        </style>
    </head>
    <body>
        <video id="videoPlayer" autoplay playsinline></video>
        <img id="imagePlayer" style="display: none" />

        <script>
            let playlist = [];
            <% videoList.forEach(schedule => { %>
                <% schedule.contents.forEach(content => { %>
                    playlist.push({ url: "<%= content.url %>", title: "<%= content.title %>" });
                <% }) %>
            <% }) %>

            let currentIndex = 0;
            let isUrgentPlaying = false;
            let backupPlaylist = [];
            let backupIndex = 0;
            const videoPlayer = document.getElementById("videoPlayer");
            const imagePlayer = document.getElementById("imagePlayer");

            function playItem(index) {
                if (!playlist[index]) return;
                const item = playlist[index];
                const ext = item.title.split('.').pop().toLowerCase();

                if (["mp4","webm","ogg"].includes(ext)) {
                    imagePlayer.style.display = "none";
                    videoPlayer.style.display = "block";
                    if (videoPlayer.src !== item.url) { // Hanya update jika berbeda
                        videoPlayer.src = item.url;
                    }
                    videoPlayer.play().catch(err => console.log("Play error:", err));
                } else if (["jpg","jpeg","png","gif"].includes(ext)) {
                    videoPlayer.style.display = "none";
                    imagePlayer.style.display = "block";
                    if (imagePlayer.src !== item.url) { // Hanya update jika berbeda
                        imagePlayer.src = item.url;
                    }
                    setTimeout(() => {
                        currentIndex = (currentIndex + 1) % playlist.length;
                        playItem(currentIndex);
                    }, 5000);
                }
            }

            videoPlayer.addEventListener("ended", () => {
                if (isUrgentPlaying && currentIndex >= playlist.length - 1) {
                    console.log("✅ Urgent playlist finished, restoring normal playlist");
                    playlist = backupPlaylist;
                    currentIndex = backupIndex;
                    isUrgentPlaying = false;
                    playItem(currentIndex);
                } else {
                    currentIndex = (currentIndex + 1) % playlist.length;
                    playItem(currentIndex);
                }
            });

            if (playlist.length > 0) playItem(currentIndex);

            const evtSource = new EventSource("/events");
            evtSource.onmessage = (event) => {
                const schedule = JSON.parse(event.data);
                console.log("SSE received:", schedule);

                if (schedule.is_urgent) {
                    console.log("🚨 Urgent playlist received:", schedule.name);

                    if (!isUrgentPlaying) {
                        backupPlaylist = [...playlist];
                        backupIndex = currentIndex;
                    }

                    playlist = schedule.contents.map(c => ({
                        url: c.url,
                        title: c.title
                    }));
                    currentIndex = 0;
                    isUrgentPlaying = true;
                    playItem(currentIndex);
                } else {
                    console.log("ℹ️ Normal playlist received:", schedule.name);
                    let wasEmpty = playlist.length === 0; // cek apakah awalnya kosong

                    schedule.contents.forEach(c => {
                        if (!playlist.some(p => p.title === c.title)) {
                            playlist.push({ url: c.url, title: c.title });
                        }
                    });

                    // Kalau awalnya kosong, langsung mulai play
                    if (wasEmpty && playlist.length > 0 && !isUrgentPlaying) {
                        currentIndex = 0;
                        playItem(currentIndex);
                    }
                }
            };
        </script>
    </body>
</html>
