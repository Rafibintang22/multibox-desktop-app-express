<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Video Player</title>
        <style>
            body {
                margin: 0;
                display: flex;
                place-items: center;
                min-width: 320px;
                min-height: 100vh;
            }
            video {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                object-fit: cover;
            }
        </style>
    </head>
    <body>
        <video id="videoPlayer" autoplay playsinline></video>

        <script>
            // Playlist dibangun dari server
            const videoList = [
                <% videoList.forEach((url) => { %>
                    "<%= url %>",
                <% }); %>
            ];

            let currentIndex = 0;
            const videoPlayer = document.getElementById("videoPlayer");

            function playVideo(index) {
                if (!videoList[index]) return;
                videoPlayer.src = videoList[index];
                videoPlayer.play().catch(err => console.log("Play error:", err));
            }

            // Event: lanjut ke video berikutnya
            videoPlayer.addEventListener("ended", () => {
                currentIndex = (currentIndex + 1) % videoList.length; // looping
                playVideo(currentIndex);
            });

            if(videoList.length > 0) playVideo(currentIndex);
            else console.log("Tidak ada video untuk diputar");
        </script>
    </body>
</html>
